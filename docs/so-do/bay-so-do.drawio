many;endFill=0;" edge="1" parent="1" source="c9" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="nhận tiền" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;" edge="1" parent="1" source="c2" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="duyệt (reviewed_by)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="xác nhận tiền" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="c2" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="&lt;b&gt;app_user xuất hiện ở ba vai&lt;/b&gt;&lt;br/&gt;chủ xe của car · người thuê của booking · người duyệt ở id_document.reviewed_by. Vẽ đủ ba đường, đừng gộp." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1250" y="90" width="260" height="96" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;car_availability không có cột id&lt;/b&gt;&lt;br/&gt;Khoá chính là cặp (car_id, day) — chính nó là trọng tài chống hai người đặt trùng ngày." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1250" y="220" width="260" height="96" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;ledger_entry trỏ mềm&lt;/b&gt;&lt;br/&gt;Không có khoá ngoại tới payment hay payout. Dùng cặp (ref_type, ref_id) vì một bút toán có thể trỏ tới ba loại chứng từ." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1250" y="350" width="260" height="106" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;Ba bảng chỉ ghi thêm&lt;/b&gt;&lt;br/&gt;payment · payout · ledger_entry không bao giờ sửa. Số dư ví treo là tổng của sổ cái, không phải một cột." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1250" y="490" width="260" height="106" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Ba quy ước&lt;/b&gt;&lt;br/&gt;Tiền: bigint đơn vị đồng, không dùng số thực&lt;br/&gt;Ngày thuê: kiểu date, không phải timestamp&lt;br/&gt;Mốc hệ thống: UTC, hiển thị mới đổi giờ VN" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1250" y="630" width="260" height="106" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="588918675" name="04 · Tuần tự đặt xe"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1180" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Luồng 1 — đặt xe và thanh toán (mục 5.4)&lt;/b&gt;&lt;br/&gt;Giữa bước “tạo đơn” và bước “xác nhận tiền”, sàn &lt;b&gt;chưa cầm đồng nào&lt;/b&gt; — mọi lần chủ xe từ chối đều xảy ra trong khoảng đó." style="text;html=1;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="700"