d" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="POST /owner/bookings/{id}/reject" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="c3" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="quá 30 phút · tác vụ nền" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="c3" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="quá 30 phút · tác vụ nền" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="c4" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="POST /bookings/{id}/cancel" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="c3" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="POST /bookings/{id}/cancel" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="c4" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="POST /bookings/{id}/cancel" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="c5" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="khách phản đối biên bản GIAO" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="c6" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="&lt;b&gt;Bảy trạng thái chính, bốn kiểu kết thúc.&lt;/b&gt;&lt;br/&gt;HOAN_TAT · BI_TU_CHOI · HET_HAN · DA_HUY là trạng thái cuối, không đi đâu được nữa." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="620" width="300" height="86" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Mũi tên đỏ đứt nét&lt;/b&gt; xuất phát từ &lt;b&gt;nhiều&lt;/b&gt; trạng thái, không phải một. Sau khi đã ký biên bản GIAO thì không cho huỷ nữa — xe đã ra khỏi tay chủ, phải đi qua đường trả xe." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="730" width="300" height="116" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Vì sao chủ xe nhận đơn trước, khách trả tiền sau&lt;/b&gt;&lt;br/&gt;Đảo lại thì mỗi lần chủ xe từ chối, sàn đang giữ tiền của khách và phải hoàn — sinh ra cả một luồng hoàn tiền cho tình huống lẽ ra không nên xảy ra." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="900" y="420" width="320" height="116" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Nhả lịch&lt;/b&gt;&lt;br/&gt;Mọi đường vào BI_TU_CHOI · HET_HAN · DA_HUY đều xoá dải ngày trong car_availability, để xe bán lại được ngay." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="900" y="570" width="320" height="96" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="375068221" name="08 · Lớp tầng dữ liệu app"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="980" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Tầng dữ liệu app Android — mục 5.7&lt;/b&gt;&lt;br/&gt;Bốn lớp xếp dọc, phụ thuộc chỉ đi một chiều từ trên xuống." style="text;html=1;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="620" height="40" as="geometry"/></mxCell><mxCell id="man" value="Màn hình Compose" style="swimlane;html=1;startSize=26;fontStyle=1;fontSize=11;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="90" y="90" width="330" height="104" as="geometry"/></mxCell><mxCell id="c3" value="OwnerHomeScreen · CarListScreen · CarDetailScreen&lt;br/&gt;BookingDetailScreen · HandoverGiaoScreen&lt;br/&gt;ProfileScreen · NewsScreen&lt;br/&gt;&lt;i&gt;chỉ đọc StateFlow và gọi hàm ViewModel&lt;/i&gt;" style="shape=rectangle;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="man"><mxGeometry x="10" y="26" width="310" height="70" as="geometry"/></mxCell><mxCell id="vm" value="ViewModel" style="swimlane;html=1;startSize=26;fontStyle=1;fontSize=11;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="90" y="250" width="330" height="108" as="geometry"/></mxCell><mxCell id="c5" value="uiState: StateFlow&amp;lt;UiState&amp;gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;data class UiState&lt;/b&gt;&lt;br/&gt;loading · dữ liệu · errorCode · errorMessage&lt;br/&gt;&lt;i&gt;một đối tượng trạng thái, không phải năm biến rời&lt;/i&gt;" style="shape=rectangle;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="vm"><mxGeometry x="10" y="26" width="310" height="74" as="geometry"/></mxCell><mxCell id="rp" value="Repository" style="swimlane;html=1;startSize=26;fontStyle=1;fontSize=11;align=center;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="90" y="420" width="330" height="104" as="geometry"/></mxCell><mxCell id="c7" value="AuthRepo · OwnerRepo · BookingRepo&lt;br/&gt;HandoverRepo · FileRepo · NewsRepo&lt;br/&gt;&lt;i&gt;gói mọi lời gọi mạng vào ApiResult&amp;lt;T&amp;gt;&lt;/i&gt;&lt;br/&gt;&lt;i&gt;chặn hết ngoại lệ, quy về mã lỗi&lt;/i&gt;" style="shape=rectangle;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="rp"><mxGeometry x="10" y="26" width="310" height="70" as="geometry"/></mxCell><mxCell id="rt" value="Interface Retrofit" style="swimlane;html=1;startSize=26;fontStyle=1;fontSize=11;align=center;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="90" y="590" width="330" height="100" as="geometry"/></mxCell><mxCell id="c9" value="AuthApi · OwnerApi · BookingApi&lt;br/&gt;HandoverApi · FileApi · NewsApi&lt;br/&gt;&lt;i&gt;khai đúng các đường dẫn trong docs/api.md&lt;/i&gt;" style="shape=rectangle;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="rt"><mxGeometry x="10" y="26" width="310" height="66" as="geometry"/></mxCell><mxCell id="ar" value="&lt;b&gt;ApiResult&amp;lt;T&amp;gt;&lt;/b&gt; &lt;i&gt;sealed&lt;/i&gt;" style="swimlane;html=1;startSize=26;fontStyle=1;fontSize=11;align=center;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="500" y="420" width="250" height="104" as="geometry"/></mxCell><mxCell id="c11" value="Ok(data: T)&lt;br/&gt;Err(code: ErrorCode, message: String)&lt;br/&gt;&lt;br/&gt;&lt;i&gt;giao diện bắt theo code, không bắt theo câu chữ&lt;/i&gt;" style="shape=rectangle;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="ar"><mxGeometry x="10" y="26" width="230" height="70" as="geometry"/></mxCell><mxCell id="di" value="&lt;b&gt;NetworkModule&lt;/b&gt; &lt;i&gt;Hilt&lt;/i&gt;" style="swimlane;html=1;startSize=26;fontStyle=1;fontSize=11;align=center;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="500" y="250" width="250" height="108" as="geometry"/></mxCell><mxCell id="c13" value="@Provides OkHttpClient&lt;br/&gt;@Provides Retrofit + Gson&lt;br/&gt;@Singleton mọi Repository&lt;br/&gt;&lt;i&gt;tiêm vào ViewModel và Repository&lt;/i&gt;" style="shape=rectangle;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="di"><mxGeometry x="10" y="26" width="230" height="74" as="geometry"/></mxCell><mxCell id="ok" value="&lt;b&gt;OkHttpClient&lt;/b&gt;" style="swimlane;html=1;startSize=26;fontStyle=1;fontSize=11;align=center;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="500" y="590" width="540" height="170" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;AuthInterceptor&lt;/b&gt;&lt;br/&gt;gắn Authorization: Bearer&lt;br/&gt;vào mọi yêu cầu" style="shape=rectangle;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="ok"><mxGeometry x="10" y="30" width="165" height="60" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;DemoInterceptor&lt;/b&gt;&lt;br/&gt;backend trả 404 hoặc mất mạng&lt;br/&gt;→ quay sang dữ liệu demo" style="shape=rectangle;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="ok"><mxGeometry x="185" y="30" width="175" height="60" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Gson adapters&lt;/b&gt;&lt;br/&gt;LocalDate: ngày trần&lt;br/&gt;OffsetDateTime: ISO có múi giờ" style="shape=rectangle;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="ok"><mxGeometry x="370" y="30" width="160" height="60" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;TokenStore&lt;/b&gt; — giữ JWT trong DataStore, đọc lại khi mở app" style="shape=rectangle;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontSize=10;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="ok"><mxGeometry x="10" y="100" width="520" height="40" as="geometry"/></mxCell><mxCell id="c19" value="đọc StateFlow · gọi hàm" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=11;" edge="1" parent="1" source="man" target="vm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="gọi hàm treo (suspend)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=11;" edge="1" parent="1" source="vm" target="rp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="gọi đường dẫn" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=11;" edge="1" parent="1" source="rp" target="rt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="thực thi yêu cầu" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;fontSize=11;" edge="1" parent="1" source="rt" target="ok"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="&amp;laquo;dùng&amp;raquo;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;endArrow=open;fontSize=11;" edge="1" parent="1" source="rp" target="ar"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="&amp;laquo;tiêm&amp;raquo;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;endArrow=open;strokeColor=#9673a6;fontSize=11;" edge="1" parent="1" source="di" target="vm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="&amp;laquo;tiêm&amp;raquo;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;endArrow=open;strokeColor=#9673a6;fontSize=11;" edge="1" parent="1" source="di" target="rp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="&amp;laquo;tạo&amp;raquo;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;endArrow=open;strokeColor=#9673a6;fontSize=11;" edge="1" parent="1" source="di" target="ok"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="&lt;b&gt;Màn hình không bao giờ gọi thẳng&lt;/b&gt; Repository hay Retrofit. Nhờ vậy đổi nguồn dữ liệu không phải sửa màn hình nào." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="90" y="790" width="330" height="86" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Không lớp nào phía trên phải bắt ngoại lệ&lt;/b&gt; — Repository đã quy mọi lỗi mạng về một mã trong ErrorCode. Mỗi màn hình chỉ cần một hàm dịch mã sang tiếng Việt." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="500" y="790" width="330" height="96" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Chế độ demo&lt;/b&gt;&lt;br/&gt;DemoInterceptor đặt cuối chuỗi, nên app chạy đủ luồng khi không có máy chủ — dùng để trình bày." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="880" y="790" width="330" height="96" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>