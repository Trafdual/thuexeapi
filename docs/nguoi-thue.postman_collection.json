{
  "info": {
    "name": "Sàn thuê xe — API người thuê",
    "description": "Theo docs/api.md và controller. Chạy từ trên xuống: đăng nhập khách → tải ảnh → nộp giấy tờ → tìm xe → báo giá → đặt xe → xem/huỷ đơn → biên bản.\n\nBiến: baseUrl, renterPhone, renterPassword. Token và id tự bắt từ phản hồi.\n\nTài khoản seed (POST /dev/seed): 0901234567 / test.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5160"
    },
    {
      "key": "renterPhone",
      "value": "0901234567"
    },
    {
      "key": "renterPassword",
      "value": "test"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "renterToken",
      "value": ""
    },
    {
      "key": "carId",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "handoverId",
      "value": ""
    },
    {
      "key": "handoverTraId",
      "value": ""
    },
    {
      "key": "anhUrl",
      "value": "/files/mau/xe-1.jpg"
    },
    {
      "key": "maDon",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1 · Xác thực",
      "item": [
        {
          "name": "Đăng ký",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"0900000002\",\n  \"password\": \"test\",\n  \"fullName\": \"Khách thuê thử\",\n  \"email\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "OTP in ra log backend ở môi trường dev.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 hoặc PHONE_TAKEN\", () => pm.expect([200,422]).to.include(pm.response.json().status));"
                ]
              }
            }
          ]
        },
        {
          "name": "Xác thực OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/verify-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "verify-otp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"0900000002\",\n  \"otp\": \"000000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Thay otp bằng mã thật đọc từ log backend thì ra 200 + token.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 hoặc OTP_INVALID\", () => pm.expect([200,422]).to.include(pm.response.json().status));",
                  "if (pm.response.json().status === 200) pm.collectionVariables.set(\"renterToken\", pm.response.json().data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Đăng nhập (khách)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{renterPhone}}\",\n  \"password\": \"{{renterPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Tự lưu token. Dùng tài khoản seed 0901234567 / test hoặc tài khoản vừa đăng ký.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.expect(pm.response.json().status).to.eql(200));",
                  "const d = pm.response.json().data;",
                  "pm.collectionVariables.set(\"token\", d.token);",
                  "pm.test(\"có profile\", () => pm.expect(d).to.have.property(\"profile\"));"
                ]
              }
            }
          ]
        }
      ]
