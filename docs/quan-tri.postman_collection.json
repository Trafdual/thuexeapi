    {
      "name": "6 · Sổ cái",
      "item": [
        {
          "name": "Tra sổ cái một đơn",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/ledger?bookingId={{maDon}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "ledger"
              ],
              "query": [
                {
                  "key": "bookingId",
                  "value": "{{bookingId}}"
                }
              ]
            },
            "description": "Dùng khi đối soát lệch. `account` là một trong `KHACH` `CHU_XE` `SAN` `VI_TREO`.\n\nF6 · **Lệch một đồng cũng không bỏ qua** — web tô đỏ khi `canBang: false`."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.expect(pm.response.json().status).to.eql(200));",
                  "const d = pm.response.json().data;",
                  "pm.test(\"có bút toán\", () => pm.expect(d.entries.length).to.be.above(0));",
                  "pm.test(\"backend tự báo cân bằng\", () => pm.expect(d.canBang).to.be.true);",
                  "pm.test(\"tổng NỢ = tổng CÓ\", () => {",
                  "  const no = d.entries.filter(e => e.direction === \"NO\").reduce((s,e) => s + e.amount, 0);",
                  "  const co = d.entries.filter(e => e.direction === \"CO\").reduce((s,e) => s + e.amount, 0);",
                  "  pm.expect(no).to.eql(co); });",
                  "pm.test(\"tiền là số nguyên đồng\", () => d.entries.forEach(e =>",
                  "  pm.expect(Number.isInteger(e.amount)).to.be.true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Tra sổ cái đơn không tồn tại",
