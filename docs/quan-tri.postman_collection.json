            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/payments/{{paymentId}}/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "payments",
                "{{paymentId}}",
                "confirm"
              ]
            },
            "description": "**Số tiền phải đúng bằng `payment.amount`** — xem ở thẻ 'Lấy id phiếu thu'.\nDữ liệu mẫu đổi giá xe thì sửa lại con số này.\n\nĐủ tiền → ghi bút toán vào ví treo, đơn sang `DA_XAC_NHAN`, **mở địa chỉ giao xe\nvà số điện thoại cho hai bên**.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"receivedAmount\": 4860000,\n  \"bankNote\": \"LE HOANG CUONG chuyen KNM9P4M5\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.expect(pm.response.json().status).to.eql(200));",
                  "const d = pm.response.json().data;",
                  "if (d.khopSoTien) {",
                  "  pm.test(\"đơn sang DA_XAC_NHAN\", () => pm.expect(d.booking.status).to.eql(\"DA_XAC_NHAN\"));",
                  "  pm.test(\"mở số điện thoại khách\", () => pm.expect(d.booking.renter.phone).to.be.a(\"string\"));",
                  "} else {",
                  "  pm.test(\"số tiền phải khớp — sửa receivedAmount cho đúng payment.amount\", () =>",
                  "    pm.expect.fail(\"lệch \" + d.lechSoTien));",
                  "}"
                ]
              }
            }
          ]
