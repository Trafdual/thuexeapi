    },
    {
      "name": "5 · Chi trả",
      "item": [
        {
          "name": "Danh sách phải chuyển khoản",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/payouts?status=CHO",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "payouts"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "CHO"
                }
              ]
            },
            "description": "**Việc mỗi tối của người vận hành.**\n\n⚠ Lệnh hoàn cọc cho khách có `bankAccount = \"CHUA_CO\"` — lược đồ 14 bảng không\ncó chỗ lưu số tài khoản của khách. Web phải hiện cảnh báo để người vận hành hỏi\nkhách trước khi chuyển."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.expect(pm.response.json().status).to.eql(200));",
                  "const d = pm.response.json().data;",
                  "if (d.length) pm.collectionVariables.set(\"payoutId\", d[0].id);",
                  "pm.test(\"đủ số tài khoản để chuyển\", () => { if (d.length) {",
                  "  pm.expect(d[0]).to.have.property(\"bankAccount\");",
                  "  pm.expect(d[0]).to.have.property(\"bankName\"); } });",
                  "pm.test(\"kèm người nhận để gọi khi lỗi\", () => { if (d.length)",
                  "  pm.expect(d[0].payee).to.have.property(\"phone\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Ghi nhận đã chuyển",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
