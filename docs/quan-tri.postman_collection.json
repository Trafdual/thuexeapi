              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.expect(pm.response.json().status).to.eql(200));",
                  "const d = pm.response.json().data;",
                  "pm.test(\"không khớp số tiền\", () => pm.expect(d.khopSoTien).to.be.false);",
                  "pm.test(\"lệch âm\", () => pm.expect(d.lechSoTien).to.be.below(0));",
                  "pm.test(\"đơn KHÔNG tự xác nhận\", () =>",
                  "  pm.expect(d.booking.status).to.eql(\"CHO_THANH_TOAN\"));"
                ]
