      "item": [
        {
          "name": "Chốt phí khi đơn chưa tới bước quyết toán",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/bookings/{{maDon}}/settle",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "bookings",
                "{{maDon}}",
                "settle"
              ]
            },
            "description": "Đơn phải ở `CHO_QUYET_TOAN` mới chốt được — tức là đã có đủ hai biên bản giao và\ntrả, và chủ xe đã ký biên bản trả.\n\nMuốn chạy nhánh thuận thì đi hết luồng biên bản ở bộ sưu tập chính trước.\n\nKhi chạy được, trả `{ booking, charges, payouts, ledger }`:\n- đơn sang `CHO_CHI_TRA`\n- sinh **đúng hai** lệnh chi: một `CHU_XE`, một `KHACH`\n- sổ cái bút toán kép, **tổng NỢ = tổng CÓ**\n\nF2 · Phí lớn hơn cọc thì trừ hết cọc, khách hoàn 0 đồng, phần thiếu thành khoản nợ.\nKhông gửi `charges` thì backend **tự tính phí** từ hai biên bản.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"charges\": [\n    {\n      \"type\": \"QUA_KM\",\n      \"amount\": 150000,\n      \"note\": \"quá 30km\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"422 lỗi nghiệp vụ\", () => pm.expect(pm.response.json().status).to.eql(422));",
                  "pm.test(\"code = WRONG_STATE\", () => pm.expect(pm.response.json().code).to.eql(\"WRONG_STATE\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Chốt phí với loại phí lạ",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/bookings/{{maDon}}/settle",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "bookings",
                "{{maDon}}",
                "settle"
              ]
            },
            "description": "Chỉ nhận ba loại: `QUA_GIO` `QUA_KM` `NHIEN_LIEU`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"charges\": [\n    {\n      \"type\": \"PHI_LA\",\n      \"amount\": 50000,\n      \"note\": null\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
